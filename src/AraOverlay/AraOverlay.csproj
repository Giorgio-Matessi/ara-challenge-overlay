<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AraChallengeOverlay</AssemblyName>
    <RootNamespace>AraOverlay</RootNamespace>
    <ApplicationIcon>AraOverlay.ico</ApplicationIcon>

    <!-- Publish settings, so a league member gets one file and nothing to install.
         WPF pulls in native DLLs (PresentationNative, wpfgfx, vcruntime140, D3DCompiler,
         PenImc) that PublishSingleFile leaves loose beside the exe unless this is set. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon covers Explorer and the taskbar; the tray needs it as a stream too.
         LogicalName pins the resource name, which otherwise depends on RootNamespace. -->
    <EmbeddedResource Include="AraOverlay.ico" LogicalName="AraOverlay.ico" />

    <!-- Baked in, so the single-file exe still has it. Link fixes the pack URI the XAML uses. -->
    <Resource Include="..\..\assets\waiting-banner.png" Link="assets\waiting-banner.png" />
    <Resource Include="..\..\assets\background-image.png" Link="assets\background-image.png" />
    <Resource Include="..\..\assets\gold.png" Link="assets\gold.png" />
    <Resource Include="..\..\assets\silver.png" Link="assets\silver.png" />
    <Resource Include="..\..\assets\bronze.png" Link="assets\bronze.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IRSDKSharper" Version="1.1.9" />

    <!-- DPAPI for the stored session token. MIT, so GPL-3 compatible. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <ProjectReference Include="..\AraOverlay.Core\AraOverlay.Core.csproj" />
  </ItemGroup>

</Project>
