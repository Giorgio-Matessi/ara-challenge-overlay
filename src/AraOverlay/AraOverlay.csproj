<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AraChallengeOverlay</AssemblyName>
    <RootNamespace>AraOverlay</RootNamespace>

    <!-- Publish settings, so a league member gets one file and nothing to install.
         WPF pulls in native DLLs (PresentationNative, wpfgfx, vcruntime140, D3DCompiler,
         PenImc) that PublishSingleFile leaves loose beside the exe unless this is set. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IRSDKSharper" Version="1.1.9" />
    <ProjectReference Include="..\AraOverlay.Core\AraOverlay.Core.csproj" />
  </ItemGroup>

</Project>
