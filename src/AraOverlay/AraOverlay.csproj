<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AraChallengeOverlay</AssemblyName>
    <RootNamespace>AraOverlay</RootNamespace>
    <ApplicationIcon>AraOverlay.ico</ApplicationIcon>

    <!-- Publish settings, so a league member gets one file and nothing to install.
         WPF pulls in native DLLs (PresentationNative, wpfgfx, vcruntime140, D3DCompiler,
         PenImc) that PublishSingleFile leaves loose beside the exe unless this is set. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Size. The bundled runtime is nearly all of the exe; compression roughly halves it at the
         cost of unpacking in memory at launch. Trimming would do more but WPF doesn't support it.
         The UI is English only, so the other languages' framework resources are dead weight. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon covers Explorer and the taskbar; the tray needs it as a stream too.
         LogicalName pins the resource name, which otherwise depends on RootNamespace. -->
    <EmbeddedResource Include="AraOverlay.ico" LogicalName="AraOverlay.ico" />

    <!-- Baked in, so the single-file exe still has it. Link fixes the pack URI the XAML uses. -->
    <Resource Include="..\..\assets\waiting-banner.png" Link="assets\waiting-banner.png" />
    <Resource Include="..\..\assets\background-image.png" Link="assets\background-image.png" />
    <Resource Include="..\..\assets\gold.png" Link="assets\gold.png" />
    <Resource Include="..\..\assets\silver.png" Link="assets\silver.png" />
    <Resource Include="..\..\assets\bronze.png" Link="assets\bronze.png" />

    <!-- Brand fonts, gitignored: the ITF licence forbids putting them in a repository (#49).
         A glob, so a clone without them still builds, in Segoe UI. -->
    <Resource Include="fonts\*.otf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IRSDKSharper" Version="1.1.9" />

    <!-- DPAPI for the stored session token. MIT, so GPL-3 compatible. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <ProjectReference Include="..\AraOverlay.Core\AraOverlay.Core.csproj" />
  </ItemGroup>

  <!-- A release must not quietly ship in Segoe UI. These are the weights MainWindow uses. -->
  <Target Name="RequireBrandFonts" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('fonts\Sentient-Regular.otf') Or !Exists('fonts\Sentient-Medium.otf') Or !Exists('fonts\Sentient-Bold.otf')"
           Text="Release builds need Sentient-Regular, -Medium and -Bold.otf in src/AraOverlay/fonts/. Download Sentient from fontshare.com; see the README." />
  </Target>

</Project>
