<Window x:Class="AraOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARA Challenge Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink"    Color="#F4F7F9"/>
        <SolidColorBrush x:Key="Dim"    Color="#8C99A3"/>
        <SolidColorBrush x:Key="Gold"   Color="#F2C14E"/>
        <SolidColorBrush x:Key="Silver" Color="#C5CDD4"/>
        <SolidColorBrush x:Key="Bronze" Color="#C98B5E"/>

        <Style x:Key="Tier" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TierTime" TargetType="TextBlock" BasedOn="{StaticResource Tier}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Visibility="Collapsed">

        <!-- Standing panel -->
        <Border x:Name="Panel"
                Background="#D910181C"
                CornerRadius="10"
                Padding="14,11"
                BorderThickness="1"
                BorderBrush="#20FFFFFF"
                MouseLeftButtonDown="OnPanelDrag">
            <StackPanel MinWidth="250">

                <TextBlock x:Name="TitleText"
                           Text="ARA Challenge Overlay"
                           FontFamily="Segoe UI Semibold" FontSize="11"
                           Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap" MaxWidth="300"/>

                <TextBlock x:Name="TrackText"
                           Visibility="Collapsed"
                           Margin="0,3,0,0"
                           FontFamily="Segoe UI Semibold" FontSize="15"
                           Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" MaxWidth="300"/>

                <TextBlock x:Name="CarText"
                           Visibility="Collapsed"
                           FontFamily="Segoe UI" FontSize="13"
                           Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap" MaxWidth="300"/>

                <Grid x:Name="Targets" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GOLD"   Style="{StaticResource Tier}" Foreground="{StaticResource Gold}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="GoldTime"   Text="—" Style="{StaticResource TierTime}" Foreground="{StaticResource Gold}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="GoldMark"   Text="" MinWidth="18" Style="{StaticResource TierTime}" Foreground="{StaticResource Gold}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SILVER" Style="{StaticResource Tier}" Foreground="{StaticResource Silver}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SilverTime" Text="—" Style="{StaticResource TierTime}" Foreground="{StaticResource Silver}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="SilverMark" Text="" MinWidth="18" Style="{StaticResource TierTime}" Foreground="{StaticResource Silver}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="BRONZE" Style="{StaticResource Tier}" Foreground="{StaticResource Bronze}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BronzeTime" Text="—" Style="{StaticResource TierTime}" Foreground="{StaticResource Bronze}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="BronzeMark" Text="" MinWidth="18" Style="{StaticResource TierTime}" Foreground="{StaticResource Bronze}"/>
                </Grid>

                <TextBlock x:Name="StatusText"
                           Margin="0,9,0,0"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
        </Border>

        <!-- Medal banner, shown for a few seconds when a tier is earned -->
        <Border x:Name="Banner"
                Visibility="Collapsed"
                Background="#F2101418"
                CornerRadius="10"
                Padding="22,16"
                BorderThickness="2">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="BannerTitle"
                           FontFamily="Segoe UI Black" FontSize="30"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="BannerTime"
                           FontFamily="Consolas" FontSize="22"
                           Foreground="{StaticResource Ink}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="BannerSub"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
