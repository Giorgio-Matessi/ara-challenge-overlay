<Window x:Class="AraOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARA Challenge Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink"    Color="#F4F7F9"/>
        <SolidColorBrush x:Key="Dim"    Color="#8C99A3"/>
        <SolidColorBrush x:Key="Gold"   Color="#F2C14E"/>
        <SolidColorBrush x:Key="Silver" Color="#C5CDD4"/>
        <SolidColorBrush x:Key="Bronze" Color="#C98B5E"/>
        <SolidColorBrush x:Key="Behind" Color="#E4564A"/>
        <SolidColorBrush x:Key="Ahead"  Color="#5BD16A"/>
        <SolidColorBrush x:Key="Rule"   Color="#1AFFFFFF"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Rule}"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="10,1"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">

        <!-- Shown until iRacing is running. Sized off the panel, which keeps its layout slot
             while hidden, so the overlay is the same box whichever layer is up. MinWidth is the
             panel's own minimum, covering the first layout pass before ActualWidth is real. -->
        <Border x:Name="Waiting"
                Width="{Binding ActualWidth, ElementName=Panel}"
                Height="{Binding ActualHeight, ElementName=Panel}"
                MinWidth="368"
                Background="#D910181C"
                CornerRadius="10"
                Padding="14,9"
                BorderThickness="1"
                BorderBrush="#20FFFFFF"
                MouseLeftButtonDown="OnPanelDrag">
            <Image Source="/assets/waiting-banner.png" Stretch="Uniform"/>
        </Border>

        <!-- Standing panel -->
        <Border x:Name="Panel"
                Visibility="Hidden"
                Background="#D910181C"
                CornerRadius="10"
                Padding="14,9"
                BorderThickness="1"
                BorderBrush="#20FFFFFF"
                MouseLeftButtonDown="OnPanelDrag">
            <StackPanel MinWidth="340" MaxWidth="560">

                <!-- Challenge | track | car -->
                <Border Style="{StaticResource Row}" Padding="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText" Grid.Column="0" Style="{StaticResource Label}"
                                   Foreground="{StaticResource Ink}" Text="ARA CHALLENGE OVERLAY"/>
                        <Border x:Name="HeaderDivider1" Grid.Column="1" Style="{StaticResource Divider}"/>
                        <TextBlock x:Name="TrackText" Grid.Column="2" Style="{StaticResource Label}"/>
                        <Border x:Name="HeaderDivider2" Grid.Column="3" Style="{StaticResource Divider}"/>
                        <TextBlock x:Name="CarText" Grid.Column="4" Style="{StaticResource Label}"/>
                    </Grid>
                </Border>

                <!-- Goal | estimated lap -->
                <Border x:Name="GoalRow" Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Label}" Text="GOAL" Margin="0,0,6,0"/>
                            <TextBlock x:Name="GoalTier" Style="{StaticResource Label}"
                                       Foreground="{StaticResource Ink}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="GoalTime" Style="{StaticResource Value}" Text="—"/>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Divider}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource Label}" Text="EST. LAP" Margin="0,0,6,0"/>
                            <TextBlock x:Name="EstLapText" Style="{StaticResource Value}" Text="—"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Last lap against the goal -->
                <Border x:Name="DeltaRow" Style="{StaticResource Row}" Padding="0,7,0,9">
                    <TextBlock x:Name="DeltaText"
                               Text="—"
                               FontFamily="Segoe UI Black" FontSize="34"
                               Foreground="{StaticResource Dim}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Last lap | session best -->
                <Border x:Name="LapRow" Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Label}" Text="LAST LAP" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LastLapText" Style="{StaticResource Value}" Text="—"/>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Divider}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource Label}" Text="SESSION BEST" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SessionBestText" Style="{StaticResource Value}"
                                       Foreground="{StaticResource Bronze}" Text="—"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The three targets -->
                <Grid x:Name="Targets" Margin="0,7,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Gold}" Text="GOLD" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GoldTime" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Gold}" Text="—"/>
                        <TextBlock x:Name="GoldMark" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Gold}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Silver}" Text="SILVER" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SilverTime" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Silver}" Text="—"/>
                        <TextBlock x:Name="SilverMark" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Silver}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Bronze}" Text="BRONZE" Margin="0,0,6,0"/>
                        <TextBlock x:Name="BronzeTime" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Bronze}" Text="—"/>
                        <TextBlock x:Name="BronzeMark" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Bronze}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Shown instead of the rows above when nothing matches -->
                <TextBlock x:Name="StatusText"
                           Visibility="Collapsed"
                           Margin="0,7,0,1"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Medal banner, shown for a few seconds when a tier is earned -->
        <Border x:Name="Banner"
                Visibility="Collapsed"
                Background="#F2101418"
                CornerRadius="10"
                Padding="22,16"
                BorderThickness="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="BannerTitle"
                           FontFamily="Segoe UI Black" FontSize="30"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="BannerTime"
                           FontFamily="Consolas" FontSize="22"
                           Foreground="{StaticResource Ink}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="BannerSub"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
