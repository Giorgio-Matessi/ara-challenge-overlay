<Window x:Class="AraOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARA Challenge Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink"    Color="#F4F7F9"/>
        <SolidColorBrush x:Key="Dim"    Color="#8C99A3"/>
        <SolidColorBrush x:Key="Gold"   Color="#F2C14E"/>
        <SolidColorBrush x:Key="Silver" Color="#C5CDD4"/>
        <SolidColorBrush x:Key="Bronze" Color="#C98B5E"/>
        <SolidColorBrush x:Key="Behind" Color="#F06A5E"/>
        <SolidColorBrush x:Key="Ahead"  Color="#5BD16A"/>
        <SolidColorBrush x:Key="Rule"   Color="#1AFFFFFF"/>

        <!-- Medal banner backgrounds, keyed by medal name. Half opacity over the banner's dark
             base: any more and the white text drops under 4.5:1 on gold and bronze. -->
        <ImageBrush x:Key="GoldArt"   ImageSource="/assets/gold.png"   Stretch="UniformToFill" Opacity="0.5"/>
        <ImageBrush x:Key="SilverArt" ImageSource="/assets/silver.png" Stretch="UniformToFill" Opacity="0.5"/>
        <ImageBrush x:Key="BronzeArt" ImageSource="/assets/bronze.png" Stretch="UniformToFill" Opacity="0.5"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
    </Window.Resources>

    <!-- Sentient for everything (#49). The fonts are gitignored, so a build without them falls
         back to Segoe UI; Release refuses to build without them. -->
    <Grid x:Name="Root" TextElement.FontFamily="./fonts/#Sentient, Segoe UI">

        <!-- Shown until iRacing is running. The image is 1000x600, so it needs an explicit
             width or it sizes the whole window: 410 is the panel's full width. -->
        <Grid x:Name="Waiting" MouseLeftButtonDown="OnPanelDrag">
            <Image Source="/assets/waiting-banner.png" Width="410"/>

            <!-- How to move and lock, while unlocked. Top, where the art is navy across its width. -->
            <TextBlock x:Name="WaitingHint" Style="{StaticResource Label}" Foreground="{StaticResource Ink}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Standing panel. The art sits at 0.4 over an opaque navy base, so no sim shows through
             and its light corner stays dark enough for Dim and Behind to hold 4.5:1. The Border's
             CornerRadius does the rounding. -->
        <Border x:Name="Panel"
                Visibility="Collapsed"
                CornerRadius="10"
                Padding="14,9"
                BorderThickness="1"
                BorderBrush="#20FFFFFF"
                MouseLeftButtonDown="OnPanelDrag">
            <Border.Background>
                <DrawingBrush Stretch="UniformToFill">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#051220" Geometry="M0,0 H1000 V600 H0 Z"/>
                            <DrawingGroup Opacity="0.4">
                                <ImageDrawing ImageSource="/assets/background-image.png" Rect="0,0,1000,600"/>
                            </DrawingGroup>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <!-- Fixed, not Min/Max, so a long category name ellipsizes rather than growing the panel. -->
            <StackPanel Width="380">

                <!-- Category · number. Docked so a long category ellipsizes before the WET pill does. -->
                <Border Style="{StaticResource Row}" Padding="0,0,0,6">
                    <DockPanel HorizontalAlignment="Center">
                        <!-- Wet sessions only: wet and dry targets differ by up to 34 s. The negative
                             margin cancels the outline so the row is no taller than when dry. -->
                        <Border x:Name="WetMark" DockPanel.Dock="Right" Visibility="Collapsed"
                                BorderBrush="{StaticResource Ink}" BorderThickness="1" CornerRadius="7"
                                Padding="6,0" Margin="8,-1,0,-1" VerticalAlignment="Center">
                            <TextBlock Text="WET" FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource Ink}"/>
                        </Border>
                        <TextBlock x:Name="TitleText" Style="{StaticResource Label}" TextAlignment="Center"
                                   Foreground="{StaticResource Ink}" Text="ARA CHALLENGE OVERLAY"/>
                    </DockPanel>
                </Border>

                <!-- Gap to the goal: live while the lap is clean, else the last lap's -->
                <Border x:Name="DeltaRow" Style="{StaticResource Row}" Padding="0,5,0,7">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="DeltaText"
                                   Text="—"
                                   FontWeight="Bold" FontSize="34"
                                   Foreground="{StaticResource Dim}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DeltaCaption" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- The three targets, gold first. ShowTier enlarges the goal and greys what's held. -->
                <Border x:Name="Medals" Style="{StaticResource Row}" Padding="0,5">
                    <StackPanel>
                        <Grid x:Name="GoldRow" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GoldLabel" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" Text="GOLD"/>
                            <TextBlock x:Name="GoldTime" Grid.Column="1" Style="{StaticResource Value}" Foreground="{StaticResource Gold}" Text="—"/>
                            <TextBlock x:Name="GoldMark" Grid.Column="2" Style="{StaticResource Label}" Foreground="{StaticResource Gold}"/>
                        </Grid>
                        <Grid x:Name="SilverRow" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SilverLabel" Style="{StaticResource Label}" Foreground="{StaticResource Silver}" Text="SILVER"/>
                            <TextBlock x:Name="SilverTime" Grid.Column="1" Style="{StaticResource Value}" Foreground="{StaticResource Silver}" Text="—"/>
                            <TextBlock x:Name="SilverMark" Grid.Column="2" Style="{StaticResource Label}" Foreground="{StaticResource Silver}"/>
                        </Grid>
                        <Grid x:Name="BronzeRow" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BronzeLabel" Style="{StaticResource Label}" Foreground="{StaticResource Bronze}" Text="BRONZE"/>
                            <TextBlock x:Name="BronzeTime" Grid.Column="1" Style="{StaticResource Value}" Foreground="{StaticResource Bronze}" Text="—"/>
                            <TextBlock x:Name="BronzeMark" Grid.Column="2" Style="{StaticResource Label}" Foreground="{StaticResource Bronze}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Last lap and session best, kept quiet on purpose -->
                <TextBlock x:Name="FooterText" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,6,0,1"/>

                <!-- Shown instead of the rows above when nothing matches -->
                <TextBlock x:Name="StatusText"
                           Visibility="Collapsed"
                           Margin="0,7,0,1"
                           FontSize="12"
                           Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap"/>

                <!-- Shown instead of the rows above while a login is open. There is no button:
                     the panel is click-through when locked, so the tray drives this. -->
                <StackPanel x:Name="Login" Visibility="Collapsed" Margin="0,7,0,1">
                    <TextBlock x:Name="LoginPrompt"
                               Style="{StaticResource Label}"
                               Foreground="{StaticResource Dim}"
                               HorizontalAlignment="Center"
                               Text="ENTER THIS CODE IN YOUR BROWSER"/>
                    <TextBlock x:Name="LoginCode"
                               FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource Ink}"
                               HorizontalAlignment="Center" Margin="0,4"/>
                    <TextBlock x:Name="LoginMessage"
                               FontSize="11"
                               Foreground="{StaticResource Dim}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- How to move and lock, while unlocked. Last, so it moves nothing above it. -->
                <TextBlock x:Name="LockHint" Style="{StaticResource Label}" HorizontalAlignment="Center"
                           Margin="0,6,0,1" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Medal banner, shown for a few seconds when a tier is earned. 410 matches the panel:
             380 content, 14 padding and 1 border either side. -->
        <Border x:Name="Banner"
                Visibility="Collapsed"
                Width="410"
                Background="#F2101418"
                CornerRadius="10"
                BorderThickness="2">
            <Grid>
                <Border x:Name="BannerArt" CornerRadius="8"/>
                <StackPanel HorizontalAlignment="Center" Margin="22,16">
                    <TextBlock x:Name="BannerTitle"
                               FontWeight="Bold" FontSize="30"
                               Foreground="{StaticResource Ink}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BannerTime"
                               FontSize="22"
                               Foreground="{StaticResource Ink}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock x:Name="BannerSub"
                               FontSize="12"
                               Foreground="{StaticResource Ink}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
